// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH.JS (NEXTAUTH) MODELOS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ─────────────────────────────────────────────
// ENUM
// ─────────────────────────────────────────────

enum Rol {
  SUPERADMIN
  ADMIN_EMPRESA
  PREVENCIONISTA
  SUPERVISOR
  TRABAJADOR
  AUDITOR
  LECTURA
}

enum DocumentoOrigenFirma {
  documento_trabajador
  documento_empresa
  entrega_epp
  capacitacion
  induccion
  acreditacion
  otro
}

enum EstadoFirmaDocumento {
  pendiente
  firmado
  rechazado
  expirado
}

enum EstadoInduccion {
  pendiente
  en_progreso
  completada
  cancelada
}

enum EstadoEntregaEpp {
  pendiente_firma
  firmada
  cancelada
}

enum EstadoContratistaDocumento {
  pendiente
  en_revision
  aprobado
  rechazado
  vencido
}

enum EstadoChecklistEjecucion {
  borrador
  completada
}

enum RespuestaChecklistValor {
  cumple
  no_cumple
  no_aplica
}

enum EstadoAccidenteInvestigacion {
  abierta
  en_investigacion
  cerrada
}

enum EstadoAccionCorrectiva {
  pendiente
  en_proceso
  completada
  cancelada
}

enum EstadoEvidenciaCumplimiento {
  pendiente
  valida
  rechazada
  vencida
}

enum EstadoDs44Diagnostico {
  en_evaluacion
  completado
}

enum RespuestaDs44Diagnostico {
  si
  no
  no_aplica
}

// ─────────────────────────────────────────────
// MODELOS BASE MULTIEMPRESA
// ─────────────────────────────────────────────

model Empresa {
  id                    String   @id @default(cuid())
  nombre                String
  activa                Boolean  @default(true)
  rut                   String?
  razonSocial           String?
  giro                  String?
  direccion             String?
  tipoEmpresa           String?
  tamanoEmpresa         String?
  codigoCiiu            String?
  inicioActividades     String?
  ciudad                String?
  region                String?
  telefono              String?
  correo                String?
  web                   String?
  logoUrl               String?
  representanteLegal    String?
  rutRepresentanteLegal String?
  mutualidad            String?
  cotizacionAdicional   String?
  cantidadTrabajadores  Int      @default(0)
  activacionPasoActual   Int?
  activacionCompletada   Boolean  @default(false)
  activacionCompletadaEn DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  usuarios                  Usuario[]
  usuariosEmpresa           UsuarioEmpresa[]
  modulos                   EmpresaModulo[]
  documentosEmpresa         DocumentoEmpresa[]
  trabajadorDocumentos      TrabajadorDocumento[]      @relation("TrabajadorDocumentosEmpresa")
  centrosTrabajo            CentroTrabajo[]
  areas                     Area[]
  cargos                    Cargo[]
  trabajadores              Trabajador[]
  posicionesDotacion        PosicionDotacion[]
  vehiculos                 Vehiculo[]
  obligacionesEstado        ObligacionEmpresaEstado[]
  hallazgosCumplimiento     HallazgoCumplimiento[]
  evidenciasCumplimiento    EvidenciaCumplimiento[]
  documentoTiposTrabajador  DocumentoTipoTrabajador[]
  documentoTiposVehiculo    DocumentoTipoVehiculo[]
  vehiculoDocumentos        VehiculoDocumento[]
  reglasDocumentoTrabajador ReglaDocumentoTrabajador[]
  capacitaciones            Capacitacion[]
  capacitacionAsignaciones  CapacitacionAsignacion[]
  capacitacionSesiones      CapacitacionSesion[]
  capacitacionHistoriales   CapacitacionHistorial[]
  capacitacionEvaluaciones  CapacitacionEvaluacion[]
  capacitacionAsistencias   CapacitacionAsistencia[]
  planCapacitaciones        PlanCapacitacion[]
  reglasCapacitacionCargo    ReglaCapacitacionCargo[]
  plantillasPlanCapacitacion PlantillaPlanCapacitacion[]
  plantillasDocumentoEmpresa  PlantillaDocumentoEmpresa[]
  activacionEventos          ActivacionEvento[]
  firmasDocumento            FirmaDocumento[]
  firmasUsuarioPerfil        FirmaUsuarioPerfil[]
  inducciones                 InduccionTrabajador[]
  documentosInduccionGenerados DocumentoInduccionGenerado[]
  documentosGenerados         DocumentoGeneradoRegistro[]
  entregasEpp                 EntregaEpp[]
  eppItems                    EppItem[]
  checklistTemplates          ChecklistTemplate[]
  checklistEjecuciones        ChecklistEjecucion[]
  contratistas                Contratista[]
  contratistaDocumentos       ContratistaDocumento[]
  contratistaTrabajadores     ContratistaTrabajador[]
  accidenteInvestigaciones    AccidenteInvestigacion[]
  accidenteAccionesCorrectivas AccidenteAccionCorrectiva[]
  // Acreditaciones
  mandantesAcreditacion      MandanteAcreditacion[]
  plantillasAcreditacion     PlantillaAcreditacion[]
  acreditaciones             Acreditacion[]
  // Plan de Trabajo
  planTrabajo                PlanTrabajo[]
  ds44Diagnosticos           Ds44Diagnostico[]
  ds44PlanAcciones           Ds44PlanAccion[]
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  rol       Rol
  activo    Boolean  @default(true)
  passwordHash String?
  empresaId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa                        Empresa?                       @relation(fields: [empresaId], references: [id])
  empresas                       UsuarioEmpresa[]
  documentosSubidos              DocumentoEmpresa[]             @relation("UsuarioDocumentosSubidos")
  documentosHistorial            DocumentoEmpresaHistorial[]    @relation("UsuarioDocumentoHistorial")
  trabajadorDocumentosSubidos    TrabajadorDocumento[]          @relation("UsuarioTrabajadorDocumentosSubidos")
  trabajadorDocumentosHistorial  TrabajadorDocumentoHistorial[] @relation("UsuarioTrabajadorDocumentoHistorial")
  obligacionesEstadoActualizadas ObligacionEmpresaEstado[]      @relation("UsuarioObligacionEmpresaEstado")
  hallazgosCumplimientoCreados   HallazgoCumplimiento[]         @relation("UsuarioHallazgoCumplimientoCreado")
  evidenciasCumplimientoCreadas  EvidenciaCumplimiento[]        @relation("UsuarioEvidenciaCumplimientoCreada")
  evidenciasCumplimientoValidadas EvidenciaCumplimiento[]       @relation("UsuarioEvidenciaCumplimientoValidada")
  evidenciasCumplimientoHistorial EvidenciaCumplimientoHistorial[] @relation("UsuarioEvidenciaCumplimientoHistorial")
  capacitacionSesionesCreadas    CapacitacionSesion[]           @relation("UsuarioCapacitacionSesionCreada")
  capacitacionHistorialEventos   CapacitacionHistorial[]
  planesCapacitacionAprobadas    PlanCapacitacion[]             @relation("UsuarioPlanCapacitacionAprobada")
  planesCapacitacionItemsResponsables PlanCapacitacionItem[]     @relation("UsuarioPlanCapacitacionItemResponsable")
  activacionEventosCreados       ActivacionEvento[]             @relation("UsuarioActivacionEvento")
  induccionesCreadas             InduccionTrabajador[]          @relation("UsuarioInduccionCreada")
  firmasUsuarioPerfil            FirmaUsuarioPerfil[]
  firmasPrevencionistaAplicadas  FirmaDocumento[]               @relation("UsuarioFirmaPrevencionistaDocumento")
  documentosGenerados            DocumentoGeneradoRegistro[]    @relation("UsuarioDocumentoGenerado")
  entregasEppCreadas             EntregaEpp[]                   @relation("UsuarioEntregaEppCreada")
  checklistTemplatesCreados      ChecklistTemplate[]            @relation("UsuarioChecklistTemplateCreado")
  checklistEjecucionesRealizadas ChecklistEjecucion[]           @relation("UsuarioChecklistEjecucion")
  contratistaDocumentosRevisados ContratistaDocumento[]         @relation("UsuarioContratistaDocumentoRevisado")
  accidenteInvestigacionesCreadas AccidenteInvestigacion[]       @relation("UsuarioAccidenteInvestigacionCreada")
  accidentesAccionesResponsable   AccidenteAccionCorrectiva[]    @relation("UsuarioAccionCorrectivaResponsable")
  // Acreditaciones
  acreditacionesResponsable      Acreditacion[]
  acreditacionesHistorial        HistorialAcreditacion[]
}

model UsuarioEmpresa {
  id        String   @id @default(cuid())
  usuarioId String
  empresaId String
  rol       Rol
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@index([usuarioId])
  @@index([activo])
}

model EmpresaModulo {
  id        String   @id @default(cuid())
  empresaId String
  modulo    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, modulo])
  @@index([empresaId])
  @@index([modulo])
  @@index([activo])
}

model ActivacionEvento {
  id         String   @id @default(uuid())
  empresaId  String
  usuarioId  String?
  evento     String
  pasoActual Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation("UsuarioActivacionEvento", fields: [usuarioId], references: [id])

  @@index([empresaId, evento])
  @@index([createdAt])
}

model DocumentoEmpresa {
  id                    String    @id @default(uuid())
  nombre                String
  categoria             String
  tipo                  String?
  estado                String
  version               String    @default("1.0")
  archivoNombre         String?
  archivoNombreOriginal String?
  archivoUrl            String?
  archivoTipo           String?
  archivoPeso           Int?
  tieneVencimiento      Boolean   @default(false)
  fechaEmision          DateTime?
  fechaVencimiento      DateTime?
  observaciones         String?
  empresaId             String
  subidoPorId           String
  documentoRequeridoId  String?
  creadoPorEmail        String?
  firmado               Boolean   @default(false)
  firmadoPor            String?   // nombre del usuario que firmó
  firmadoEn             DateTime? // fecha/hora de la firma
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa            Empresa                     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  subidoPor          Usuario                     @relation("UsuarioDocumentosSubidos", fields: [subidoPorId], references: [id])
  documentoRequerido DocumentoRequeridoEmpresa?  @relation(fields: [documentoRequeridoId], references: [id])
  historial          DocumentoEmpresaHistorial[]
  evidenciasCumplimiento EvidenciaCumplimiento[]

  @@unique([empresaId, documentoRequeridoId])
}

model PlantillaDocumentoEmpresa {
  id            String   @id @default(uuid())
  empresaId     String
  codigo        String
  contenidoBase String
  activa        Boolean  @default(true)
  version       String   @default("1.0")
  createdAt     DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([codigo])
}

model DocumentoRequeridoEmpresa {
  id                      String   @id @default(uuid())
  nombre                  String
  categoria               String
  descripcion             String
  obligatorio             Boolean  @default(true)
  aplicaDesdeTrabajadores Int?
  aplicaHastaTrabajadores Int?
  requiereVencimiento     Boolean  @default(false)
  periodicidadMeses       Int?
  activo                  Boolean  @default(true)
  orden                   Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  documentos            DocumentoEmpresa[]
  requisitosAcreditacion RequisitoPlantillaAcreditacion[] @relation("RequisitoDocumentoRequeridoEmpresa")

  @@unique([nombre, categoria])
}

model DocumentoEmpresaHistorial {
  id                    String   @id @default(uuid())
  documentoId           String
  usuarioId             String?
  accion                String
  detalle               String?
  version               String?
  archivoNombre         String?
  archivoNombreOriginal String?
  archivoUrl            String?
  archivoTipo           String?
  archivoPeso           Int?
  createdAt             DateTime @default(now())

  documento DocumentoEmpresa @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario   Usuario?         @relation("UsuarioDocumentoHistorial", fields: [usuarioId], references: [id])
}

model ObligacionEmpresaEstado {
  id               String   @id @default(uuid())
  empresaId        String
  obligacionClave  String
  cumple           Boolean  @default(false)
  estado           String
  observacion      String?
  actualizadoPorId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  actualizadoPor Usuario? @relation("UsuarioObligacionEmpresaEstado", fields: [actualizadoPorId], references: [id])
  evidenciasCumplimiento EvidenciaCumplimiento[] @relation("EvidenciaObligacionEstado")

  @@unique([empresaId, obligacionClave])
  @@index([empresaId])
  @@index([actualizadoPorId])
}

model Ds44Diagnostico {
  id          String                @id @default(cuid())
  empresaId   String
  estado      EstadoDs44Diagnostico @default(en_evaluacion)
  scoreGlobal Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  empresa      Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  respuestas   Ds44DiagnosticoRespuesta[]
  planAcciones Ds44PlanAccion[]

  @@index([empresaId])
  @@index([estado])
  @@index([updatedAt])
}

model Ds44PlanAccion {
  id                 String   @id @default(cuid())
  empresaId          String
  diagnosticoId      String?
  responsableTrabajadorId String?
  preguntaClave      String
  bloque             String?
  prioridad          String
  accionSugerida     String
  recomendacion      String
  evidenciaEsperada  String?
  rutaSugerida       String?
  frenteOperativo    String?
  responsableSugerido String?

  responsableReal    String?
  fechaCompromiso    DateTime?
  estado             String   @default("pendiente")
  observacionTecnica String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa               Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  diagnostico           Ds44Diagnostico? @relation(fields: [diagnosticoId], references: [id], onDelete: SetNull)
  responsableTrabajador Trabajador?      @relation("TrabajadorDs44PlanAccionResponsable", fields: [responsableTrabajadorId], references: [id], onDelete: SetNull)
  evidenciasCumplimiento EvidenciaCumplimiento[]

  @@unique([empresaId, preguntaClave])
  @@index([empresaId])
  @@index([diagnosticoId])
  @@index([responsableTrabajadorId])
  @@index([prioridad])
  @@index([estado])
  @@index([fechaCompromiso])
}

model Ds44DiagnosticoRespuesta {
  id           String                    @id @default(cuid())
  diagnosticoId String
  bloque       String
  preguntaClave String
  preguntaTexto String
  respuesta    RespuestaDs44Diagnostico
  puntaje      Int?
  observacion  String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  diagnostico Ds44Diagnostico @relation(fields: [diagnosticoId], references: [id], onDelete: Cascade)

  @@unique([diagnosticoId, preguntaClave])
  @@index([diagnosticoId])
  @@index([bloque])
  @@index([respuesta])
}

model HallazgoCumplimiento {
  id              String   @id @default(uuid())
  empresaId       String
  centroTrabajoId String?
  trabajadorId    String?
  checklistRespuestaId String?
  obligacionClave String?
  tipo            String
  prioridad       String
  descripcion     String
  estado          String
  fechaCompromiso DateTime
  creadoPorId     String
  responsableId   String?
  responsableNombre String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  centroTrabajo CentroTrabajo? @relation(fields: [centroTrabajoId], references: [id], onDelete: SetNull)
  trabajador    Trabajador?    @relation(fields: [trabajadorId], references: [id], onDelete: SetNull)
  responsableTrabajador Trabajador? @relation("TrabajadorHallazgoCumplimientoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  checklistRespuesta ChecklistRespuesta? @relation(fields: [checklistRespuestaId], references: [id], onDelete: SetNull)
  creadoPor     Usuario        @relation("UsuarioHallazgoCumplimientoCreado", fields: [creadoPorId], references: [id])
  evidenciasCumplimiento EvidenciaCumplimiento[]

  @@index([empresaId])
  @@index([centroTrabajoId])
  @@index([trabajadorId])
  @@index([checklistRespuestaId])
  @@index([obligacionClave])
  @@index([estado])
  @@index([creadoPorId])
  @@index([responsableId])
  @@unique([checklistRespuestaId])
}

model CentroTrabajo {
  id                   String   @id @default(uuid())
  empresaId            String
  nombre               String
  direccion            String
  comuna               String
  region               String
  tipo                 String
  estado               String
  cantidadTrabajadores Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  empresa                   Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  trabajadores              Trabajador[]
  posicionesDotacion        PosicionDotacion[]
  vehiculos                 Vehiculo[]
  hallazgosCumplimiento     HallazgoCumplimiento[]
  evidenciasCumplimiento    EvidenciaCumplimiento[]
  checklistEjecuciones      ChecklistEjecucion[]
  accidenteInvestigaciones  AccidenteInvestigacion[]
  reglasDocumentoTrabajador ReglaDocumentoTrabajador[]
  planCapacitacionItems     PlanCapacitacionItem[]
  reglasCapacitacionCargo   ReglaCapacitacionCargo[]
  plantillaItemsCapacitacion PlantillaPlanCapacitacionItem[]

  @@index([empresaId])
}

model Area {
  id          String   @id @default(uuid())
  empresaId   String
  nombre      String
  descripcion String?
  estado      String   @default("activa")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa                   Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cargos                    Cargo[]
  trabajadores              Trabajador[]
  reglasDocumentoTrabajador ReglaDocumentoTrabajador[]
  planCapacitacionItems     PlanCapacitacionItem[]
  reglasCapacitacionCargo   ReglaCapacitacionCargo[]
  plantillaItemsCapacitacion PlantillaPlanCapacitacionItem[]

  @@index([empresaId])
}

model Cargo {
  id          String   @id @default(uuid())
  empresaId   String
  areaId      String?
  nombre      String
  descripcion String?
  perfilSST   String?
  perfilSstRequerido String?
  riesgosClave Json?
  documentosBase Json?
  capacitacionesBase Json?
  estado      String   @default("activo")
  esCritico   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa                   Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  area                      Area?                      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  trabajadores              Trabajador[]
  posicionesDotacion        PosicionDotacion[]
  reglasDocumentoTrabajador ReglaDocumentoTrabajador[]
  planCapacitacionItems     PlanCapacitacionItem[]
  reglasCapacitacionCargo   ReglaCapacitacionCargo[]
  plantillaItemsCapacitacion PlantillaPlanCapacitacionItem[]

  @@index([empresaId])
  @@index([areaId])
}

model Trabajador {
  id                 String    @id @default(uuid())
  empresaId          String
  centroTrabajoId    String?
  areaId             String?
  cargoId            String?
  posicionDotacionId String?
  nombres            String
  apellidos          String
  rut                String?
  email              String?
  telefono           String?
  estado             String    @default("activo")
  fechaIngreso       DateTime?
  fechaNacimiento    DateTime?
  tipoContrato       String?
  jornada            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  empresa                  Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  centroTrabajo            CentroTrabajo?           @relation(fields: [centroTrabajoId], references: [id], onDelete: SetNull)
  area                     Area?                    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  cargo                    Cargo?                   @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  posicionDotacion         PosicionDotacion?        @relation(fields: [posicionDotacionId], references: [id], onDelete: SetNull)
  documentos               TrabajadorDocumento[]
  hallazgosCumplimiento    HallazgoCumplimiento[]
  hallazgosResponsable     HallazgoCumplimiento[]   @relation("TrabajadorHallazgoCumplimientoResponsable")
  ds44PlanAccionesResponsable Ds44PlanAccion[]      @relation("TrabajadorDs44PlanAccionResponsable")
  evidenciasCumplimiento   EvidenciaCumplimiento[]
  capacitacionAsignaciones CapacitacionAsignacion[]
  capacitacionHistoriales  CapacitacionHistorial[]
  capacitacionEvaluaciones CapacitacionEvaluacion[]
  capacitacionAsistencias  CapacitacionAsistencia[]
  firmasDocumento          FirmaDocumento[]
  inducciones              InduccionTrabajador[]
  documentosInduccionGenerados DocumentoInduccionGenerado[]
  entregasEpp              EntregaEpp[]
  checklistEjecuciones     ChecklistEjecucion[]
  accidenteInvestigaciones AccidenteInvestigacion[]
  contratistaVinculos      ContratistaTrabajador[]
  // Acreditaciones
  acreditacionesTrabajador AcreditacionTrabajador[]

  @@index([empresaId])
  @@index([centroTrabajoId])
  @@index([areaId])
  @@index([cargoId])
  @@index([posicionDotacionId])
}

model EvidenciaCumplimiento {
  id              String   @id @default(uuid())
  empresaId       String
  titulo          String
  descripcion     String   @default("")
  origen          String   @default("manual")
  tipo            String
  estado          EstadoEvidenciaCumplimiento
  fechaEvidencia  DateTime
  observacion     String?
  archivoNombre   String?
  archivoUrl      String?
  archivoTipo     String?
  archivoPeso     Int?
  hallazgoId      String?
  obligacionClave String?
  documentoTrabajadorId String?
  documentoEmpresaId String?
  checklistEjecucionId String?
  entregaEppId   String?
  accionPlanId    String?
  ds44PlanAccionId String?
  centroTrabajoId String?
  trabajadorId    String?
  creadoPorId     String?
  validadoPorId   String?
  validadoAt      DateTime?
  observacionRevision String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  empresa       Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  hallazgo      HallazgoCumplimiento?   @relation(fields: [hallazgoId], references: [id], onDelete: SetNull)
