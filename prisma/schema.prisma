  id              String               @id @default(uuid())
  empresaId       String
  centroTrabajoId String?
  patente         String
  codigoInterno   String?
  tipo            String
  marca           String
  modelo          String
  anio            Int?
  estado          String               @default("operativo")
  responsable     String?
  proximaRevision String?
  kilometraje     Int?
  observaciones   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  documentos      VehiculoDocumento[]
  mantenciones    VehiculoMantencion[]
  // Acreditaciones
  acreditacionesVehiculo AcreditacionVehiculo[]

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  centroTrabajo CentroTrabajo? @relation(fields: [centroTrabajoId], references: [id], onDelete: SetNull)

  @@index([empresaId])
}

model VehiculoDocumento {
  id                    String   @id @default(uuid())
  empresaId             String
  vehiculoId            String
  tipoDocumentoId       String?
  tipo                  String
  subido                Boolean  @default(false)
  vencimiento           String?
  estado                String   @default("pendiente")
  archivoUrl            String?
  archivoNombre         String?
  archivoNombreOriginal String?
  archivoTipo           String?
  archivoPeso           Int?
  fechaEmision          DateTime?
  fechaVencimiento      DateTime?
  observaciones         String?
  subidoPorId           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  empresa       Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vehiculo      Vehiculo               @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  tipoDocumento DocumentoTipoVehiculo? @relation(fields: [tipoDocumentoId], references: [id], onDelete: SetNull)

  @@unique([vehiculoId, tipo])
  @@index([empresaId])
  @@index([vehiculoId])
  @@index([tipoDocumentoId])
  @@index([estado])
  @@index([fechaVencimiento])
}

model VehiculoMantencion {
  id            String   @id @default(uuid())
  vehiculoId    String
  tipo          String
  fecha         String
  estado        String   @default("programada")
  observaciones String?
  kilometraje   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@index([vehiculoId])
}

// ─────────────────────────────────────────────
// MÓDULO CONTRATISTAS
// ─────────────────────────────────────────────

model Contratista {
  id            String   @id @default(cuid())
  empresaId     String
  nombre        String
  rut           String?
  razonSocial   String?
  email         String?
  telefono      String?
  observaciones String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  empresa       Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  documentos    ContratistaDocumento[]
  trabajadores  ContratistaTrabajador[]
  acreditaciones Acreditacion[]

  @@index([empresaId])
  @@index([activo])
  @@index([rut])
}

model ContratistaDocumento {
  id            String                     @id @default(cuid())
  contratistaId String
  empresaId     String
  nombre        String
  tipo          String?
  estado        EstadoContratistaDocumento @default(pendiente)
  archivoUrl    String?
  archivoNombre String?
  fechaEmision  DateTime?
  fechaVencimiento DateTime?
  observaciones String?
  revisadoPorId String?
  revisadoAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  contratista Contratista @relation(fields: [contratistaId], references: [id], onDelete: Cascade)
  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  revisadoPor Usuario?    @relation("UsuarioContratistaDocumentoRevisado", fields: [revisadoPorId], references: [id], onDelete: SetNull)

  @@index([contratistaId])
  @@index([empresaId])
  @@index([estado])
  @@index([fechaVencimiento])
}

model ContratistaTrabajador {
  id            String   @id @default(cuid())
  empresaId     String
  contratistaId String
  trabajadorId  String
  createdAt     DateTime @default(now())

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratista Contratista @relation(fields: [contratistaId], references: [id], onDelete: Cascade)
  trabajador  Trabajador  @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)

  @@unique([contratistaId, trabajadorId])
  @@index([empresaId])
  @@index([contratistaId])
  @@index([trabajadorId])
}

// ─────────────────────────────────────────────
// ACREDITACIONES — MODELOS PRISMA
// ─────────────────────────────────────────────

model MandanteAcreditacion {
  id        String   @id @default(cuid())
  empresaId String
  nombre    String
  rut       String?
  tipo      String   @default("mandante") // "municipalidad" | "empresa_electrica" | "constructora" | "privado" | "otro"
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  plantillas  PlantillaAcreditacion[]
  acreditaciones Acreditacion[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([activo])
}

model PlantillaAcreditacion {
  id                  String   @id @default(cuid())
  empresaId           String
  mandanteId          String?
  nombre              String
  tipo                String   @default("mandante_general") // "municipal" | "enel" | "cge" | "mandante_general" | etc
  descripcion         String   @default("")
  origen              String   @default("nextprev") // "nextprev" | "mandante" | "cliente"
  activa              Boolean  @default(true)
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  mandante MandanteAcreditacion? @relation(fields: [mandanteId], references: [id], onDelete: SetNull)

  requisitos    RequisitoPlantillaAcreditacion[]
  acreditaciones Acreditacion[]

  @@unique([empresaId, nombre, version])
  @@index([empresaId])
  @@index([mandanteId])
  @@index([activa])
  @@index([updatedAt])
}

model RequisitoPlantillaAcreditacion {
  id                      String   @id @default(cuid())
  plantillaId             String
  nombreDocumento         String
  codigoDocumento         String?
  documentoRequeridoEmpresaId String?
  documentoTipoTrabajadorId   String?
  documentoTipoVehiculoId     String?
  categoria               String   @default("empresa") // "empresa" | "trabajador" | "sst" | "vehiculo" | "anexo"
  aplicaA                 String   @default("empresa") // "empresa" | "trabajador" | "vehiculo"
  obligatorio             Boolean  @default(true)
  permiteMultiples        Boolean  @default(false)
  requiereVencimiento     Boolean  @default(false)
  requiereRevisionManual  Boolean  @default(false)
  orden                   Int      @default(0)
  observacionAyuda        String?
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  plantilla PlantillaAcreditacion @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  documentoRequeridoEmpresa DocumentoRequeridoEmpresa? @relation("RequisitoDocumentoRequeridoEmpresa", fields: [documentoRequeridoEmpresaId], references: [id], onDelete: SetNull)
  documentoTipoTrabajador   DocumentoTipoTrabajador?   @relation("RequisitoDocumentoTipoTrabajador", fields: [documentoTipoTrabajadorId], references: [id], onDelete: SetNull)
  documentoTipoVehiculo     DocumentoTipoVehiculo?     @relation("RequisitoDocumentoTipoVehiculo", fields: [documentoTipoVehiculoId], references: [id], onDelete: SetNull)

  documentos DocumentoAcreditacion[]

  @@index([plantillaId])
  @@index([activo])
  @@index([codigoDocumento])
  @@index([documentoRequeridoEmpresaId])
  @@index([documentoTipoTrabajadorId])
  @@index([documentoTipoVehiculoId])
}

model DocumentoTipoVehiculo {
  id                  String   @id @default(uuid())
  empresaId           String
  codigo              String
  nombre              String
  descripcion         String?
  vigenciaDias        Int?
  requiereVencimiento Boolean  @default(true)
  requiereArchivo     Boolean  @default(true)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empresa               Empresa                         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vehiculoDocumentos    VehiculoDocumento[]
  requisitosAcreditacion RequisitoPlantillaAcreditacion[] @relation("RequisitoDocumentoTipoVehiculo")

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([codigo])
}

model Acreditacion {
  id                  String   @id @default(cuid())
  empresaId           String
  mandanteId          String
  plantillaId         String
  contratistaId       String?
  nombreProyecto      String?
  obraFaena           String?
  estado              String   @default("en_preparacion") // "en_preparacion" | "listo_para_enviar" | "enviado" | "observada" | "aprobado" | "rechazado" | "cerrada" | "vencido"
  responsableId       String?
  observaciones       String?
  fechaEnvio          DateTime?
  fechaRespuesta      DateTime?
  fechaVencimiento    DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  mandante MandanteAcreditacion @relation(fields: [mandanteId], references: [id], onDelete: Cascade)
  plantilla PlantillaAcreditacion @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  contratista Contratista? @relation(fields: [contratistaId], references: [id], onDelete: SetNull)
  responsable Usuario? @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  trabajadores  AcreditacionTrabajador[]
  vehiculos     AcreditacionVehiculo[]
  documentos    DocumentoAcreditacion[]
  historial     HistorialAcreditacion[]

  @@index([empresaId])
  @@index([mandanteId])
  @@index([plantillaId])
  @@index([contratistaId])
  @@index([estado])
  @@index([responsableId])
  @@index([fechaVencimiento])
  @@index([updatedAt])
}

model AcreditacionTrabajador {
  id              String   @id @default(cuid())
  acreditacionId  String
  trabajadorId    String
  createdAt       DateTime @default(now())

  acreditacion Acreditacion @relation(fields: [acreditacionId], references: [id], onDelete: Cascade)
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)

  @@unique([acreditacionId, trabajadorId])
  @@index([acreditacionId])
  @@index([trabajadorId])
}

model AcreditacionVehiculo {
  id              String   @id @default(cuid())
  acreditacionId  String
  vehiculoId      String
  createdAt       DateTime @default(now())

  acreditacion Acreditacion @relation(fields: [acreditacionId], references: [id], onDelete: Cascade)
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@unique([acreditacionId, vehiculoId])
  @@index([acreditacionId])
  @@index([vehiculoId])
}

model DocumentoAcreditacion {
  id                      String   @id @default(cuid())
  acreditacionId          String
  requisitoId             String
  titularTipo             String   @default("empresa") // "empresa" | "trabajador" | "vehiculo"
  titularId               String?  // trabajadorId, vehiculoId, etc si aplica
  titularNombre           String?
  nombreDocumento         String
  categoria               String   @default("empresa")
  obligatorio             Boolean  @default(true)
  estado                  String   @default("faltante") // "faltante" | "completo" | "vencido" | "en_revision" | "rechazado" | "no_aplica"
  archivoUrl              String?
  archivoNombre           String?
  fechaEmision            DateTime?
  fechaVencimiento        DateTime?
  fuenteTipo              String?  // "biblioteca" | "documento_empresa" | "documento_trabajador" | "manual"
  fuenteId                String?
  observaciones           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  acreditacion Acreditacion @relation(fields: [acreditacionId], references: [id], onDelete: Cascade)
  requisito RequisitoPlantillaAcreditacion @relation(fields: [requisitoId], references: [id], onDelete: Cascade)

  @@index([acreditacionId])
  @@index([requisitoId])
  @@index([estado])
  @@index([titularId])
  @@index([fechaVencimiento])
}

model HistorialAcreditacion {
  id                String   @id @default(cuid())
  acreditacionId    String
  usuarioId         String?
  accion            String   // "crear" | "cambiar_estado" | "agregar_documento" | "rechazar" | "observar" | etc
  detalle           String?
  estadoAnterior    String?
  estadoNuevo       String?
  createdAt         DateTime @default(now())

  acreditacion Acreditacion @relation(fields: [acreditacionId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([acreditacionId])
  @@index([usuarioId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// MÓDULO INDUCCIÓN DIGITAL
// ─────────────────────────────────────────────

model InduccionTrabajador {
  id            String          @id @default(cuid())
  empresaId     String
  trabajadorId  String
  token         String          @unique
  estado        EstadoInduccion @default(pendiente)
  fechaInicio   DateTime?
  fechaTermino  DateTime?
  creadoPorId   String?
  observaciones String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  creadoPor  Usuario?   @relation("UsuarioInduccionCreada", fields: [creadoPorId], references: [id], onDelete: SetNull)
  firmas     FirmaDocumento[]
  documentosGenerados DocumentoInduccionGenerado[]

  @@index([empresaId])
  @@index([trabajadorId])
  @@index([estado])
  @@index([token])
}

model DocumentoInduccionGenerado {
  id                String               @id @default(cuid())
  empresaId         String
  trabajadorId      String
  induccionId       String
  tipo              String
  titulo            String
  contenidoMarkdown String
  estado            EstadoFirmaDocumento @default(pendiente)
  firmadoPor        String?
  firmadoEn         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  empresa    Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  trabajador Trabajador         @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  induccion  InduccionTrabajador @relation(fields: [induccionId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([trabajadorId])
  @@index([induccionId])
  @@index([estado])
  @@index([tipo])
}

model DocumentoGeneradoRegistro {
  id                    String   @id @default(cuid())
  empresaId             String
  usuarioId             String?
  modulo                String
  tipoDocumento         String
  entidadTipo           String
  entidadId             String?
  nombre                String
  formato               String
  archivoNombre         String?
  archivoNombreOriginal String?
  archivoUrl            String?
  archivoTipo           String?
  archivoPeso           Int?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation("UsuarioDocumentoGenerado", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([usuarioId])
  @@index([modulo])
  @@index([tipoDocumento])
  @@index([entidadTipo, entidadId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// MÓDULO EPP
// ─────────────────────────────────────────────

model EppItem {
  id          String   @id @default(cuid())
  empresaId   String
  nombre      String
  codigo      String?
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa  Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detalles EntregaEppDetalle[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([activo])
}

model EntregaEpp {
  id            String           @id @default(cuid())
  empresaId     String
  trabajadorId  String
  estado        EstadoEntregaEpp @default(pendiente_firma)
  observaciones String?
  creadoPorId   String?
  fechaEntrega  DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  creadoPor  Usuario?   @relation("UsuarioEntregaEppCreada", fields: [creadoPorId], references: [id], onDelete: SetNull)
  detalles   EntregaEppDetalle[]
  evidenciasCumplimiento EvidenciaCumplimiento[]
  firmas     FirmaDocumento[]

  @@index([empresaId])
  @@index([trabajadorId])
  @@index([estado])
}

model EntregaEppDetalle {
  id          String   @id @default(cuid())
  entregaId   String
  eppItemId   String?
  nombre      String
  cantidad    Int      @default(1)
  talla       String?
  observacion String?
  createdAt   DateTime @default(now())

  entrega EntregaEpp @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  eppItem EppItem?   @relation(fields: [eppItemId], references: [id], onDelete: SetNull)

  @@index([entregaId])
  @@index([eppItemId])
}

// ─────────────────────────────────────────────
// MÓDULO CHECKLISTS / INSPECCIONES
// ─────────────────────────────────────────────

model ChecklistTemplate {
  id          String   @id @default(cuid())
  empresaId   String
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  creadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa     Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  creadoPor   Usuario?             @relation("UsuarioChecklistTemplateCreado", fields: [creadoPorId], references: [id], onDelete: SetNull)
  preguntas   ChecklistPregunta[]
  ejecuciones ChecklistEjecucion[]

  @@index([empresaId])
  @@index([activo])
}

model ChecklistPregunta {
  id          String   @id @default(cuid())
  templateId  String
  texto       String
  orden       Int
  obligatorio Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template   ChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  respuestas ChecklistRespuesta[]

  @@index([templateId])
  @@index([orden])
}

model ChecklistEjecucion {
  id              String                   @id @default(cuid())
  empresaId       String
  templateId      String
  ejecutadoPorId  String
  centroTrabajoId String?
  trabajadorId    String?
  estado          EstadoChecklistEjecucion @default(completada)
  fechaEjecucion  DateTime                 @default(now())
  observaciones   String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  empresa       Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  template      ChecklistTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ejecutadoPor  Usuario              @relation("UsuarioChecklistEjecucion", fields: [ejecutadoPorId], references: [id])
  centroTrabajo CentroTrabajo?       @relation(fields: [centroTrabajoId], references: [id], onDelete: SetNull)
  trabajador    Trabajador?          @relation(fields: [trabajadorId], references: [id], onDelete: SetNull)
  respuestas    ChecklistRespuesta[]
  evidenciasCumplimiento EvidenciaCumplimiento[]

  @@index([empresaId])
  @@index([templateId])
  @@index([estado])
  @@index([centroTrabajoId])
  @@index([trabajadorId])
}

model ChecklistRespuesta {
  id          String                  @id @default(cuid())
  ejecucionId String
  preguntaId  String
  respuesta   RespuestaChecklistValor
  comentario  String?
  createdAt   DateTime                @default(now())

  ejecucion ChecklistEjecucion @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  pregunta  ChecklistPregunta  @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  hallazgo  HallazgoCumplimiento?

  @@index([ejecucionId])
  @@index([preguntaId])
  @@index([respuesta])
}

// ─────────────────────────────────────────────
// MÓDULO ACCIDENTES / INCIDENTES
// ─────────────────────────────────────────────

model AccidenteInvestigacion {
  id              String                       @id @default(cuid())
  empresaId       String
  trabajadorId    String
  centroTrabajoId String
  creadoPorId     String
  fechaAccidente  DateTime
  tipo            String
  gravedad        String
  descripcion     String
  causaProbable   String?
  estado          EstadoAccidenteInvestigacion @default(abierta)
  fechaCierre     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  empresa       Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  trabajador    Trabajador                @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  centroTrabajo CentroTrabajo             @relation(fields: [centroTrabajoId], references: [id], onDelete: Restrict)
  creadoPor     Usuario                   @relation("UsuarioAccidenteInvestigacionCreada", fields: [creadoPorId], references: [id])
  acciones      AccidenteAccionCorrectiva[]

  @@index([empresaId])
  @@index([trabajadorId])
  @@index([centroTrabajoId])
  @@index([estado])
  @@index([fechaAccidente])
}

model AccidenteAccionCorrectiva {
  id              String                 @id @default(cuid())
  empresaId       String
  investigacionId String
  descripcion     String
  responsableId   String
  plazo           DateTime
  estado          EstadoAccionCorrectiva @default(pendiente)
  fechaCierre     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  empresa       Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  investigacion AccidenteInvestigacion @relation(fields: [investigacionId], references: [id], onDelete: Cascade)
  responsable   Usuario               @relation("UsuarioAccionCorrectivaResponsable", fields: [responsableId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@index([investigacionId])
  @@index([responsableId])
  @@index([estado])
  @@index([plazo])
}

// ─────────────────────────────────────────────
// GENERACIÓN DE DOCUMENTOS CON IA — AUDITORÍA
// ─────────────────────────────────────────────

model GeneracionDocumentosLog {
  id          String   @id @default(uuid())
  empresaId   String
  usuarioId   String
  fecha       DateTime @default(now())
  generados   Int      @default(0)
  actualizados Int     @default(0)
  omitidos    Int      @default(0)
  duracionMs  Int      @default(0)
  usoIA       Boolean  @default(false)
  errorIA     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([empresaId])
  @@index([usuarioId])
}

// ─────────────────────────────────────────────
// MÓDULO PLAN DE TRABAJO
// ─────────────────────────────────────────────

model PlanTrabajo {
  id                String    @id @default(cuid())
  empresaId         String
  anio              Int
  estadoPlan        String    @default("borrador")
  version           Int       @default(1)
  aprobadoPor       String?
  aprobadoCargo     String?
  aprobadoEn        DateTime?
  rechazadoPor      String?
  rechazadoCargo    String?
  rechazadoEn       DateTime?
  motivoRechazo     String?
  enviadoRevisionEn DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  empresa     Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  actividades ActividadPlanTrabajo[]
  historial   HistorialPlanTrabajo[]

  @@unique([empresaId, anio])
  @@index([empresaId])
  @@index([anio])
  @@index([estadoPlan])
}

model ActividadPlanTrabajo {
  id                String   @id @default(cuid())
  planId            String
  actividad         String
  normativa         String
  categoria         String
  periodicidad      String
  responsable       String
  centroContratista String
  requiereEvidencia Boolean  @default(false)
  estado            String   @default("pendiente")
  critica           Boolean  @default(false)
  mesesEstados      Json     @default("{}")
  orden             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plan       PlanTrabajo              @relation(fields: [planId], references: [id], onDelete: Cascade)
  evidencias EvidenciaActividadPlan[]

  @@index([planId])
  @@index([estado])
}

model EvidenciaActividadPlan {
  id          String   @id @default(cuid())
  actividadId String
  archivo     String
  archivoUrl  String?
  fecha       DateTime @default(now())
  estado      String   @default("cargada")
  observacion String?
  creadoPorId String?
  createdAt   DateTime @default(now())

  actividad ActividadPlanTrabajo @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@index([actividadId])
  @@index([estado])
}

model HistorialPlanTrabajo {
  id          String   @id @default(cuid())
  planId      String
  accion      String
  usuario     String
  archivo     String?
  actividadId String?
  createdAt   DateTime @default(now())

  plan PlanTrabajo @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([createdAt])
}
