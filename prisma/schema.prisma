model TrabajadorDocumento {
  id                    String    @id @default(uuid())
  trabajadorId          String
  empresaId             String
  nombre                String
  tipo                  String
  categoria             String    @default("trabajador")
  estado                String    @default("pendiente_carga")
  version               String    @default("1.0")
  // Versionado e historial
  esVigente             Boolean   @default(true)
  versionNumero         Int       @default(1)
  origen                String    @default("manual") // "ia" | "manual" | "sistema"
  reemplazadoPorId      String?   // ID del documento más nuevo que reemplazó a este
  motivoReemplazo       String?   // Razón del reemplazo
  archivoNombre         String?
  archivoNombreOriginal String?
  archivoUrl            String?
  archivoTipo           String?
  archivoPeso           Int?
  tieneVencimiento      Boolean   @default(false)
  fechaEmision          DateTime?
  fechaVencimiento      DateTime?
  observaciones         String?
  subidoPorId           String?
  creadoPorEmail        String?
  firmado               Boolean   @default(false)
  firmadoPor            String?   // nombre del usuario que firmó
  firmadoEn             DateTime? // fecha/hora de la firma
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  trabajador                          Trabajador                     @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  empresa                             Empresa                        @relation("TrabajadorDocumentosEmpresa", fields: [empresaId], references: [id], onDelete: Cascade)
  subidoPor                           Usuario?                       @relation("UsuarioTrabajadorDocumentosSubidos", fields: [subidoPorId], references: [id])
  historial                           TrabajadorDocumentoHistorial[]
  capacitacionAsignacionesEvidencia   CapacitacionAsignacion[]       @relation("CapAsignacionEvidenciaDocumento")
  capacitacionAsignacionesCertificado CapacitacionAsignacion[]       @relation("CapAsignacionCertificadoDocumento")
  capacitacionEvaluacionesEvidencia   CapacitacionEvaluacion[]       @relation("CapEvaluacionEvidenciaDocumento")
  evidenciasCumplimiento              EvidenciaCumplimiento[]

  @@index([trabajadorId, tipo, esVigente])
  @@index([trabajadorId])
  @@index([empresaId])
  @@index([subidoPorId])
}

model TrabajadorDocumentoHistorial {
