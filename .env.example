# Copia este archivo a .env y completa los valores.
# En producción, configura las variables desde el panel del hosting.
# No subas secretos ni credenciales reales al repositorio.

# Base de datos PostgreSQL
# Producción: usar una URL cloud real, sin reset ni db push forzado.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://usuario:password@host:5432/nextprev?schema=public"

# Auth.js / NextAuth
# Generar con: openssl rand -base64 32
AUTH_SECRET="cambia-este-secreto"
NEXTAUTH_SECRET="cambia-este-secreto"

# URL pública de la aplicación
# Producción NextPrev: https://app.nextprev.cl
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Password única del login por credenciales.
# El email debe existir en la tabla Usuario.
# En producción debe definirse explícitamente.
AUTH_DEV_PASSWORD="dev1234"

# Secreto temporal para inicializar el primer SUPERADMIN en producción.
BOOTSTRAP_SECRET="cambia-este-secreto-bootstrap"

# Email transaccional para capacitaciones, notificaciones y bienvenida de usuarios.
# RESEND_API_KEY es secreto: configúralo solo en el hosting.
# El remitente debe estar validado por el proveedor.
RESEND_API_KEY=""
CAPACITACION_FROM_EMAIL=""
EMAIL_FROM=""

# IA opcional (documentos / hallazgos / MIPER)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MIPER_MODEL="gpt-5.6-sol"

# Debug solo local / no productivo
DEBUG_REGLAS_DOCUMENTALES="0"
DEBUG_CUMPLIMIENTO_DOCUMENTAL="0"
